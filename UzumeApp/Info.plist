<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Display identity. CFBundleName drives the menu bar; CFBundleDisplayName
	     drives Finder and permission dialogs. Both live here rather than in
	     INFOPLIST_KEY_* build settings: this target sets an explicit
	     INFOPLIST_FILE, and the file wins over the generated keys — setting them
	     in the pbxproj silently left CFBundleName as $(PRODUCT_NAME). The bundle
	     on disk stays Uzume.app; RN.2 renamed the target to UzumeApp
	     without touching PRODUCT_NAME. -->
	<key>CFBundleName</key>
	<string>Uzume</string>
	<key>CFBundleDisplayName</key>
	<string>Uzume</string>
	<key>NSScreenCaptureUsageDescription</key>
	<string>Uzume captures system audio to generate real-time music visualizations. No video is recorded.</string>
	<key>NSAppleEventsUsageDescription</key>
	<string>Uzume reads track info from music apps (Apple Music, Spotify) to display what's currently playing.</string>
	<key>NSAppleMusicUsageDescription</key>
	<string>Uzume searches the Apple Music catalog to look up track details like BPM and genre for the currently playing song.</string>
	<key>SpotifyClientID</key>
	<string>$(SPOTIFY_CLIENT_ID)</string>
	<key>LSMultipleInstancesProhibited</key>
	<true/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>io.uzume.spotify-oauth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>uzume</string>
			</array>
		</dict>
	</array>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Audio File</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.mpeg-4-audio</string>
				<string>public.mp3</string>
				<string>org.xiph.flac</string>
			</array>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>m4a</string>
				<string>mp3</string>
				<string>flac</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Audio Playlist</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.m3u-playlist</string>
			</array>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>m3u</string>
				<string>m3u8</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
