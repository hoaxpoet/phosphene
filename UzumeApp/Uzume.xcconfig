// Uzume.xcconfig — build settings scoped to the UzumeApp target only.
//
// These settings are intentionally NOT on the project level. Project-level or
// command-line settings propagate to every SPM dependency target, and SPM
// dependencies (e.g. swift-collections) compile with -suppress-warnings to
// silence third-party noise. -warnings-as-errors + -suppress-warnings conflict
// at the Swift driver level, so the UzumeApp build fails the moment
// SWIFT_TREAT_WARNINGS_AS_ERRORS is set globally.
//
// Keeping it here scopes warnings-as-errors to Uzume source files while
// leaving dependencies untouched.

SWIFT_TREAT_WARNINGS_AS_ERRORS = YES

// Spotify Web API client ID for the OAuth Authorization Code + PKCE flow.
// PKCE uses only the public client ID — NO client secret (a native app must
// not embed one). Do NOT put a real value here — this file is checked in.
// Override in Uzume.local.xcconfig (see RUNBOOK §Spotify connector setup).
SPOTIFY_CLIENT_ID =

// Local credential overrides — gitignored, never checked in.
#include? "Uzume.local.xcconfig"
